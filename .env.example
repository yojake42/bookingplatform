# ---------------------------------------------------------------------------
# Local development defaults. Copy to `.env` (docker compose reads it automatically).
# Host ports are offset from the usual defaults so this stack can run alongside others.
# ---------------------------------------------------------------------------

POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_HOST_PORT=5440
DATABASE_URL=postgresql://booking:booking@postgres:5432/booking?schema=public

API_HOST_PORT=3100
WEB_HOST_PORT=5180
WEB_ORIGIN=http://localhost:5180

# Session cookie
SESSION_COOKIE_NAME=bp_session
SESSION_TTL_HOURS=336
COOKIE_SECURE=false
TRUST_PROXY=false

# First admin account, created by the seed if no admin exists yet.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Site Admin
# Set to true to add demo listings, bookings and reviews (only when the database has no listings).
SEED_DEMO_DATA=true

# Object storage (S3 API). MinIO locally, Cloudflare R2 in production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
STORAGE_ENDPOINT=http://minio:9000
# Endpoint the *browser* uses for presigned uploads.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9100
# Public read base for media URLs (bucket is anonymous-read in dev; R2 public bucket / custom domain in prod).
# Leave empty to serve media via short-lived signed URLs instead.
STORAGE_PUBLIC_BASE_URL=http://localhost:9100/booking-media
STORAGE_BUCKET=booking-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Geocoding (address search). Photon is free and OSM-based; swap for a self-hosted instance in production.
GEOCODER_URL=https://photon.komoot.io/api
GEOCODER_USER_AGENT=bookingplatform/0.1 (admin@example.com)

# Public URL of the website, used in emails and payment redirect links.
PUBLIC_WEB_URL=http://localhost:5180

# --- Payments -----------------------------------------------------------------
# "fake" opens a built-in test checkout page (no money moves; refused in production).
# "stripe" uses Stripe Checkout: set the keys below (test keys start with sk_test_ / whsec_).
# For webhooks locally: stripe listen --forward-to localhost:3100/api/payments/webhooks/stripe
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How long dates are held while the guest pays (30-1440 minutes).
PAYMENT_HOLD_MINUTES=30

# --- Email ----------------------------------------------------------------------
# "log" records emails (view them in Staff console -> Emails) without sending.
# "brevo" sends through Brevo's transactional API.
EMAIL_PROVIDER=log
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=stays@example.com
EMAIL_FROM_NAME=Haven
EMAIL_REPLY_TO=
# Comma-separated staff addresses for booking notifications (defaults to all active admins).
STAFF_NOTIFICATION_EMAILS=
